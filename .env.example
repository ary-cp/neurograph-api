# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (Vite dev + deployed frontend)
CLIENT_ORIGIN=http://localhost:5173

# ── Groq / LLaMA-3 ─────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
# true = return a fake graph without calling Groq (frontend dev / demos without quota)
MOCK_LLM=false
RATE_LIMIT_PER_MIN=30

# ── Supabase (optional until persistence is wired) ─────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Live Web Research (Jina Reader: https://jina.ai/reader) ───
# Any http(s) link in a note is fetched as Markdown and fed to the model.
# Key from https://jina.ai/?sui=apikey — optional, raises the rate limit from ~20 to 500 req/min.
JINA_API_KEY=
RESEARCH_ENABLED=true
RESEARCH_MAX_URLS=2
RESEARCH_MAX_CHARS=8000
